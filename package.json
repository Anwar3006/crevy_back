{
  "name": "crevy-backend",
  "version": "1.0.0",
  "description": "The backend service for the Crevy platform",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "npx rimraf dist && tsc",
    "start": "tsx --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "render:build": "npm ci && npm run build && npm run db:generate",
    "format": "biome format --write"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-auth": "^1.4.7",
    "biome": "^0.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "rotating-file-stream": "^3.2.7",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.2",
    "@types/pg": "^8.16.0",
    "@types/pino": "^7.0.4",
    "lefthook": "^2.0.11",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
